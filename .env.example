# LPUQuick Environment Configuration Template (Vercel + Supabase Direct)

# Server Configuration
PORT=3000
NODE_ENV=development

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Authorized Original Supabase Project (Project ref: vltnqvktdlpcltndmmwl)
SUPABASE_URL=https://vltnqvktdlpcltndmmwl.supabase.co
SUPABASE_ANON_KEY=your_vltnqvktdlpcltndmmwl_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_vltnqvktdlpcltndmmwl_service_role_key_here

# Authentication & Session Secrets (Set long random secrets in Vercel Env; never commit real secrets)
JWT_SECRET=your_jwt_secret_key_here
ADMIN_SESSION_SECRET=your_admin_session_secret_here
PARTNER_SESSION_SECRET=your_partner_session_secret_here
CUSTOMER_SESSION_SECRET=your_customer_session_secret_here
ADMIN_PASSWORD=your_admin_login_password_here

# Public App Origin URLs (Direct Vercel Hosting)
PUBLIC_APP_URL=https://lpuquick.vercel.app
APP_URL=https://lpuquick.vercel.app

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@lpu.in

# SMS & WhatsApp OTP Messaging Gateways (Disabled by default in demo mode)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

FAST2SMS_API_KEY=
TWOFACTOR_API_KEY=

# Optional Direct Postgres Connection String (vltnqvktdlpcltndmmwl pooler)
DATABASE_URL=

# Payment Processing Mode (Keep false for non-commercial Pay-on-Delivery demonstration)
PAYMENT_ENVIRONMENT=production
ONLINE_PAYMENTS_ENABLED=false
