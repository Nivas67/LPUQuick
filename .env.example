# LPUQuick Environment Configuration Template

# Server Configuration
PORT=3000
NODE_ENV=development

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Authentication & Session Secrets
JWT_SECRET=your_jwt_secret_key_here
ADMIN_SESSION_SECRET=your_admin_session_secret_here

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@lpu.in

# SMS & WhatsApp OTP Messaging Gateways
# Option A: Meta WhatsApp Business Cloud API (Recommended for WhatsApp OTP)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=

# Option B: Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Option C: Indian SMS Gateways (Optional SMS Fallback)
FAST2SMS_API_KEY=
TWOFACTOR_API_KEY=

# Database Configuration (Optional direct Postgres connection string)
DATABASE_URL=
