{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(assets|uploads)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|ico|webp|woff2|mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(admin|admin/|admin/(.*)|index\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/public/uploads/$1"
    },
    {
      "source": "/admin/css/(.*)",
      "destination": "/admin/css/$1"
    },
    {
      "source": "/admin/js/(.*)",
      "destination": "/admin/js/$1"
    },
    {
      "source": "/admin/(.*)\\.(png|jpg|jpeg|svg|ico|webp|woff2|mp3)",
      "destination": "/admin/$1.$2"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/css/(.*)",
      "destination": "/client/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/client/js/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/client/favicon.ico"
    },
    {
      "source": "/favicon.png",
      "destination": "/client/favicon.png"
    },
    {
      "source": "/logo.png",
      "destination": "/client/logo.png"
    },
    {
      "source": "/sw.js",
      "destination": "/client/sw.js"
    },
    {
      "source": "/manifest.json",
      "destination": "/client/manifest.json"
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|ico|webp|woff2|mp3|json)",
      "destination": "/client/$1.$2"
    },
    {
      "source": "/((?!api/|admin/).*)",
      "destination": "/client/index.html"
    }
  ]
}
