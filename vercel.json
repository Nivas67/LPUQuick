{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://accounts.google.com https://apis.google.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://accounts.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(assets|uploads|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(download|downloads)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(ad-new|admin|partner)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(ad-new|admin|partner)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|ico|webp|woff2|mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(index\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/hostels/active",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/api/hostels/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, private"
        }
      ]
    },
    {
      "source": "/api/hostels",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, private"
        }
      ]
    },
    {
      "source": "/api/order-mode/status",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=10, stale-while-revalidate=30"
        }
      ]
    },
    {
      "source": "/api/client/status",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=15, stale-while-revalidate=30"
        }
      ]
    },
    {
      "source": "/api/home/banners",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/banners",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/categories",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=120, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/api/categories/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/api/products",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/api/products/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=120, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/api/search",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/api/(admin|auth|cart|checkout|orders|payments|partner|notifications|security|backup|financial)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, private"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/download/apk",
      "destination": "/public/downloads/LPUQuick.apk"
    },
    {
      "source": "/downloads/apk",
      "destination": "/public/downloads/LPUQuick.apk"
    },
    {
      "source": "/download/LPUQuick.apk",
      "destination": "/public/downloads/LPUQuick.apk"
    },
    {
      "source": "/downloads/LPUQuick.apk",
      "destination": "/public/downloads/LPUQuick.apk"
    },
    {
      "source": "/download",
      "destination": "/public/downloads/LPUQuick.apk"
    },
    {
      "source": "/downloads",
      "destination": "/public/downloads/LPUQuick.apk"
    },
    {
      "source": "/download/(.*)",
      "destination": "/public/downloads/$1"
    },
    {
      "source": "/downloads/(.*)",
      "destination": "/public/downloads/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/public/uploads/$1"
    },
    {
      "source": "/img/(.*)",
      "destination": "/public/img/$1"
    },
    {
      "source": "/food",
      "destination": "/public/food.html"
    },
    {
      "source": "/food/",
      "destination": "/public/food.html"
    },
    {
      "source": "/cook",
      "destination": "/public/food.html"
    },
    {
      "source": "/cook/",
      "destination": "/public/food.html"
    },
    {
      "source": "/mobile",
      "destination": "/public/mobile-preview.html"
    },
    {
      "source": "/mobile-preview",
      "destination": "/public/mobile-preview.html"
    },
    {
      "source": "/phone",
      "destination": "/public/mobile-preview.html"
    },
    {
      "source": "/preview",
      "destination": "/public/mobile-preview.html"
    },
    {
      "source": "/ad-new/css/(.*)",
      "destination": "/admin/css/$1"
    },
    {
      "source": "/ad-new/js/(.*)",
      "destination": "/admin/js/$1"
    },
    {
      "source": "/ad-new/(.*)\\.(png|jpg|jpeg|svg|ico|webp|woff2|mp3|json)",
      "destination": "/admin/$1.$2"
    },
    {
      "source": "/ad-new-preview",
      "destination": "/public/admin-preview.html"
    },
    {
      "source": "/ad-new/preview",
      "destination": "/public/admin-preview.html"
    },
    {
      "source": "/ad-new_preview",
      "destination": "/public/admin-preview.html"
    },
    {
      "source": "/admin-preview",
      "destination": "/public/admin-preview.html"
    },
    {
      "source": "/admin/preview",
      "destination": "/public/admin-preview.html"
    },
    {
      "source": "/preview-admin",
      "destination": "/public/admin-preview.html"
    },
    {
      "source": "/mobile-admin",
      "destination": "/public/admin-preview.html"
    },
    {
      "source": "/ad-new/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/ad-new",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/css/(.*)",
      "destination": "/admin/css/$1"
    },
    {
      "source": "/admin/js/(.*)",
      "destination": "/admin/js/$1"
    },
    {
      "source": "/admin/(.*)\\.(png|jpg|jpeg|svg|ico|webp|woff2|mp3|json)",
      "destination": "/admin/$1.$2"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/partner/css/(.*)",
      "destination": "/public/partner/css/$1"
    },
    {
      "source": "/partner/js/(.*)",
      "destination": "/public/partner/js/$1"
    },
    {
      "source": "/partner/(.*)\\.(png|jpg|jpeg|svg|ico|webp|woff2|mp3|json)",
      "destination": "/public/partner/$1.$2"
    },
    {
      "source": "/partner/(.*)",
      "destination": "/public/partner/index.html"
    },
    {
      "source": "/partner",
      "destination": "/public/partner/index.html"
    },
    {
      "source": "/css/(.*)",
      "destination": "/client/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/client/js/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/client/favicon.ico"
    },
    {
      "source": "/favicon.png",
      "destination": "/client/favicon.png"
    },
    {
      "source": "/logo.png",
      "destination": "/client/logo.png"
    },
    {
      "source": "/sw.js",
      "destination": "/client/sw.js"
    },
    {
      "source": "/manifest.json",
      "destination": "/client/manifest.json"
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|ico|webp|woff2|mp3|json)",
      "destination": "/client/$1.$2"
    },
    {
      "source": "/((?!api/|ad-new/|admin/|partner/).*)",
      "destination": "/client/index.html"
    }
  ]
}
