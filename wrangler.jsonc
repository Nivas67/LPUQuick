{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lpuquick",
  "main": "./server/cloudflare-worker.mjs",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "iconv-lite": "./server/cloudflare-shims/iconv-lite.cjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/sw.js",
      "/api/*",
      "/admin",
      "/admin/*",
      "/ad-new",
      "/ad-new/*",
      "/partner",
      "/partner/*",
      "/sandbox-payment-return",
      "/sandbox-payment",
      "/food",
      "/cook",
      "/mobile",
      "/mobile-preview",
      "/phone",
      "/preview",
      "/admin-preview",
      "/preview-admin",
      "/mobile-admin",
      "/ad-new-preview",
      "/ad-new_preview",
      "/download",
      "/downloads",
      "/download/*",
      "/downloads/*"
    ]
  },
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKERS": "1",
    "PAYMENT_ENVIRONMENT": "sandbox",
    "PUBLIC_APP_URL": "https://lpuquick.vercel.app",
    "APP_URL": "https://lpuquick.vercel.app",
    "UPI_GATEWAY_BASE_URL": "https://paylpuquick.freecpanel.shop/api/v1",
    "SANDBOX_SUPABASE_URL": "https://mgsxeguulxumfgehpphb.supabase.co",
    "SANDBOX_ALLOWED_SUPABASE_REFS": "mgsxeguulxumfgehpphb",
    "SANDBOX_SUPABASE_SCHEMA": "public"
  }
}
